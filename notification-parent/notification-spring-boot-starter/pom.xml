<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.bilalefeuysl.notification</groupId>
    <artifactId>notification-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>notification-spring-boot-starter</artifactId>
  <name>notification-spring-boot-starter</name>
  <description>Auto-configuration - tek dependency ile calisir</description>

  <dependencies>
    <dependency>
      <groupId>io.github.bilalefeuysl.notification</groupId>
      <artifactId>notification-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.bilalefeuysl.notification</groupId>
      <artifactId>notification-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.bilalefeuysl.notification</groupId>
      <artifactId>notification-rest-api</artifactId>
    </dependency>

    <!-- @AutoConfiguration, @ConditionalOnProperty vb. buradan geliyor -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- @EnableConfigurationProperties buradan. notification-core artik
         spring-boot'u "provided" verdigi icin (asagi akmiyor) burada acikca
         bildiriyoruz - zaten spring-boot-autoconfigure transitif getiriyor
         ama dogrudan kullandigimiz icin explicit olmasi dogru. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>

    <!-- NotificationProperties'teki @Validated + bean-validation'i acilista
         calistiran dogrulayici motor (Hibernate Validator). Bozuk ayar
         (orn. notification.rest.max-limit=0) acilista net hatayla reddedilir. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- notification.datasource.* doldurulursa kendi baglantimizi kurmak icin.
         optional: tuketici uygulama farkli bir connection pool kullaniyorsa
         (ya da hic notification.datasource.* ayarlamiyorsa) HikariCP'yi
         classpath'ine almak zorunda kalmasin. Pratikte spring-boot-starter-jdbc/
         -data-jpa kullanan her uygulamada zaten transitif olarak vardir.
         notification.datasource.url ayarlanmis AMA HikariCP yoksa acilista
         net bir hata verilir (bkz. NotificationAutoConfiguration). -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
    <groupId>com.fasterxml.jackson.datatype</groupId>
    <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Testler: gercek bir Spring Boot uygulamasi gibi ayaga kaldirip
         DataSource + WebSocket + REST'in birlikte calistigini dogrulamak icin -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>